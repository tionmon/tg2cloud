# backend
PORT=51947
PUBLIC_API_URL=http://localhost:51947
CORS_ORIGIN=http://localhost:47832
DATA_DIR=./data

# required admin authentication
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
AUTH_SESSION_HOURS=12
# Number of reverse proxies in front of Express. Keep 0 for direct local access.
TRUST_PROXY_HOPS=0
# Set true when PUBLIC_API_URL uses HTTPS. When omitted, it is inferred from PUBLIC_API_URL.
AUTH_COOKIE_SECURE=false

# optional Telegram bot
TELEGRAM_BOT_TOKEN=

# optional Google Drive OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# frontend build
VITE_API_URL=http://localhost:51947
